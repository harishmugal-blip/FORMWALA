  {
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "\nconst cs = $('Compute Step').first().json;\nconst nextIdx = Number(cs.idx || 0) + 1;\nconst fields = cs.fields || [];\nreturn [{ json: { done: nextIdx >= fields.length, nextIdx, fields } }];"
   },

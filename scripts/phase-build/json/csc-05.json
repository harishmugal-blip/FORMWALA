  {
   "parameters": {
    "resource": "row",
    "operation": "get",
    "dataTableId": {
     "__rl": true,
     "mode": "name",
     "value": "service_pricing"
    },
    "matchType": "allConditions",
    "filters": {
     "conditions": [
      {
       "keyName": "service_id",
       "condition": "eq",
       "keyValue": "={{ $('Route Action').first().json.service_id }}"
      }
     ]
    },
    "returnAll": false,
    "limit": 1
   },
   "name": "Get Pricing Row",
   "type": "n8n-nodes-base.dataTable",
   "typeVersion": 1.1,
   "position": [
    0,
    0
   ],
   "alwaysOutputData": true
  },
  {
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "\nconst action = $('Route Action').first().json.action;\nconst input = $('Route Action').first().json.input;\nlet service = {};\ntry { service = $('Get Service Row').first().json || {}; } catch (e) {}\nlet fields = [], docs = [];\ntry { fields = $('Get Fields').all().map(i => i.json); } catch (e) {}\ntry { docs = $('Get Docs').all().map(i => i.json); } catch (e) {}\nlet pricing = {};\ntry { pricing = $('Get Pricing Row').first().json || {}; } catch (e) {}\nconst seenF = new Set(); fields = fields.filter(f => f && f.field_key && !seenF.has(f.field_key) && seenF.add(f.field_key));\nfields.sort((a, b) => (a.field_order || 0) - (b.field_order || 0));\nconst seenD = new Set(); docs = docs.filter(d => d && d.doc_key && !seenD.has(d.doc_key) && seenD.add(d.doc_key));\ndocs.sort((a, b) => (a.doc_order || 0) - (b.doc_order || 0));\nlet processing_steps = [];\ntry { processing_steps = JSON.parse(service.processing_steps || '[]'); } catch (e) {}\nconst payload = { ok: !!service.service_id, action, service, fields, documents: docs, pricing, processing_steps };\nif (action === 'get_pricing') return [{ json: { ok: !!pricing.service_id, action, pricing: { gov_fee: pricing.gov_fee || 0, service_charge: pricing.service_charge || 0, gst_percent: pricing.gst_percent || 0, gst_amount: pricing.gst_amount || 0, total_fee: pricing.total_fee || 0 }, input } }];\nreturn [{ json: payload }];"
   },
   "name": "Build Full Config",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    0,
    0
   ]
  },
  {
   "parameters": {
    "resource": "row",
    "operation": "get",
    "dataTableId": {
     "__rl": true,
     "mode": "name",
     "value": "service_catalog"
    },
    "matchType": "allConditions",
    "filters": {
     "conditions": [
      {
       "keyName": "active",
       "condition": "eq",
       "keyValue": "TRUE"
      }
     ]
    },
    "returnAll": true
   },
   "name": "Get All Services",
   "type": "n8n-nodes-base.dataTable",
   "typeVersion": 1.1,
   "position": [
    0,
    0
   ],
   "alwaysOutputData": true
  },
  {
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "\nconst rows = $input.all().map(i => i.json).filter(r => r && r.service_id);\nconst list = rows.map(s => ({ service_id: s.service_id, service_name: s.service_name, category: s.category, description: s.description, total_fee: s.total_fee, gov_fee: s.government_fee, service_charge: s.service_charge }));\nreturn [{ json: { ok: true, action: 'list_services', services: list, catalog: list } }];"
   },
   "name": "Build Service List",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    0,
    0
   ]
  }
 ],

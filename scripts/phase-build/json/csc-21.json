{
 "id": "3c5c2121-0000-4000-8000-000000000021",
 "name": "CSC 21 - Reminder Engine (Anti-Harassment)",
 "nodes": [
  {
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "cronExpression",
       "expression": "0 9,15,21 * * *"
      }
     ]
    }
   },
   "name": "Every 6 Hours",
   "type": "n8n-nodes-base.scheduleTrigger",

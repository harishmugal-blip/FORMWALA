    0
   ],
   "alwaysOutputData": true
  },
  {
   "parameters": {
    "resource": "row",
    "operation": "get",
    "dataTableId": {
     "__rl": true,
     "mode": "name",
     "value": "system_config"
    },
    "matchType": "allConditions",
    "filters": {
     "conditions": [
      {
       "keyName": "config_key",
       "condition": "eq",
       "keyValue": "=REMINDER_QUIET_START"
      }
     ]
    },
    "returnAll": false,
    "limit": 1
   },
   "name": "Get Quiet Start",
   "type": "n8n-nodes-base.dataTable",
   "typeVersion": 1.1,
   "position": [
    0,
    0
   ],
   "alwaysOutputData": true
  },
  {
   "parameters": {
    "resource": "row",
    "operation": "get",
    "dataTableId": {
     "__rl": true,
     "mode": "name",
     "value": "system_config"
    },
    "matchType": "allConditions",
    "filters": {
     "conditions": [
      {
       "keyName": "config_key",
       "condition": "eq",
       "keyValue": "=REMINDER_QUIET_END"
      }
     ]
    },
    "returnAll": false,
    "limit": 1
   },
   "name": "Get Quiet End",
   "type": "n8n-nodes-base.dataTable",
   "typeVersion": 1.1,
   "position": [
    0,
    0
   ],
   "alwaysOutputData": true
  },
  {
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "\nconst qs = $('Get Quiet Start').first().json.config_value || '21:00';\nconst qe = $('Get Quiet End').first().json.config_value || '09:00';\nconst nowIst = new Date(Date.now() + 5.5 * 3600 * 1000);\nconst hhmm = String(nowIst.getUTCHours()).padStart(2, '0') + ':' + String(nowIst.getUTCMinutes()).padStart(2, '0');\nconst quiet = (hhmm >= qs) || (hhmm < qe);\nreturn [{ json: { quiet, hhmm, maxReminders: Number($('Get Reminder Cfg').first().json.config_value || 3) } }];"
   },
   "name": "Quiet Hours Check",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    0,
    0
   ]
  },
  {
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose",
      "version": 2
     },
     "conditions": [
      {
       "id": "c0-InQuietHours",
       "leftValue": "={{ $json.quiet }}",
       "rightValue": "true",
       "operator": {
        "type": "string",
        "operation": "equals"
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   },
   "name": "In Quiet Hours?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2.2,
   "position": [
    0,
    0
   ]
  },
  {
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "\nreturn [{ json: { skipped: true, reason: 'quiet hours - anti-harassment rule' } }];"
   },
   "name": "Skip Quiet",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    0,
    0
   ]
  },
  {
   "parameters": {

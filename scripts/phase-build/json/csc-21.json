    0,
    0
   ],
   "returnAll": true,
   "alwaysOutputData": true
  },
  {
   "parameters": {
    "resource": "row",
    "operation": "get",
    "dataTableId": {
     "__rl": true,
     "mode": "name",
     "value": "conversation_state"
    },
    "matchType": "allConditions",
    "filters": {
     "conditions": [
      {
       "keyName": "state",
       "condition": "eq",
       "keyValue": "=PAYMENT"
      }
     ]
    },
    "returnAll": true
   },
   "name": "Get PAYMENT Convos",
   "type": "n8n-nodes-base.dataTable",
   "typeVersion": 1.1,
   "position": [
    0,
    0
   ],
   "returnAll": true,
   "alwaysOutputData": true
  },
  {
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "\nconst items = [];\ntry { const _seenC = new Set(); for (const i of $('Get DOCS Convos').all()) { const it = i.json; if (!it || !it.phone || _seenC.has(it.phone)) continue; _seenC.add(it.phone); items.push({ phone: it.phone, type: 'DOCS', service_id: it.service_id, context_data: it.context_data || '{}' }); } } catch (e) {}\ntry { const _seenP = new Set(); for (const i of $('Get PAYMENT Convos').all()) { const it = i.json; if (!it || !it.phone || _seenP.has(it.phone)) continue; _seenP.add(it.phone); items.push({ phone: it.phone, type: 'PAYMENT', service_id: it.service_id, context_data: it.context_data || '{}' }); } } catch (e) {}\nreturn items.length ? items.map(i => ({ json: i })) : [{ json: { none: true } }];"
   },
   "name": "Build Reminder Items",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    0,
    0
   ]
  },
  {
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "\nconst item = $json;\nif (item.none) return [{ json: { skip: true, phone: '', reason: 'no pending conversations' } }];\nlet ctx = {};\ntry { ctx = JSON.parse(item.context_data || '{}'); } catch (e) {}\nconst count = Number(ctx.reminder_count || 0);\nconst maxR = Number($('Quiet Hours Check').first().json.maxReminders || 3);\nif (count >= maxR) return [{ json: { skip: true, phone: item.phone, reason: 'max reminders reached (' + count + ')' } }];\nlet msg;\nif (item.type === 'DOCS') msg = '\\ud83d\\udcc4 Yaad dilayein: aapke application ke documents pending hain. Photo/PDF bhejein taaki kaam aage badhe.';\nelse msg = '\\ud83d\\udcb3 Yaad dilayein: aapka payment pending hai. Payment confirm hote hi kaam aage badhega.';\nmsg += '\\n\\n(Ye reminder ' + (count + 1) + '/' + maxR + ' hai. CANCEL se band kar sakte hain.)';\nconst newCtx = JSON.stringify({ ...ctx, reminder_count: count + 1 });\nreturn [{ json: { skip: false, phone: item.phone, message: msg, type: item.type, application_id: ctx.application_id || '', newCount: count + 1, newCtx } }];"
   },
   "name": "Compute Reminder",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    0,
    0
   ]
  },

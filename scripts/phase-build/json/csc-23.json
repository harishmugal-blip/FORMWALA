     }
    ],
    [
     {
      "node": "Build Digest",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Build Digest": {
   "main": [
    [
     {
      "node": "Get Admin4",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Get Admin4": {
   "main": [
    [
     {
      "node": "Send Digest",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Daily Digest 8PM": {
   "main": [
    [
     {
      "node": "All Apps",
      "type": "main",
      "index": 0
     }
    ]
   ]
  }
 },
 "settings": {

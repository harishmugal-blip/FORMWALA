    0
   ],
   "alwaysOutputData": true
  },
  {
   "parameters": {
    "action": "hmac",
    "binaryData": false,
    "type": "SHA256",
    "value": "={{ $('Extract Signature').first().json.raw }}",
    "secret": "={{ $json.config_value || 'csc_webhook_secret_2026' }}",
    "dataEncoding": "utf8",
    "encoding": "hex"
   },
   "name": "Compute HMAC",
   "type": "n8n-nodes-base.crypto",
   "typeVersion": 1,
   "position": [
    0,
    0
   ]
  },
  {
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "\nconst computed = String($json.data || $json.encodedData || '').toLowerCase();\nconst provided = String($('Extract Signature').first().json.sig || '').toLowerCase();\nreturn [{ json: { valid: !!provided && computed === provided, computed, provided: provided, eventType: $('Extract Signature').first().json.eventType } }];"
   },
   "name": "Compare Sig",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    0,
    0
   ]
  },
  {
   "parameters": {
    "conditions": {

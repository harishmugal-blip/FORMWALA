    0,
    0
   ]
  },
  {
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "\nconst raw = $json.rawBody || (typeof $json.body === 'string' ? $json.body : JSON.stringify($json.body || {}));\nconst headers = $json.headers || {};\nconst sig = headers['x-razorpay-signature'] || '';\nlet event = {};\ntry { event = typeof raw === 'string' ? JSON.parse(raw) : raw; } catch (e) {}\nconst eventType = event.event || event.type || 'unknown';\nreturn [{ json: { raw: typeof raw === 'string' ? raw : JSON.stringify(raw), sig, eventType, event, headers } }];"
   },
   "name": "Extract Signature",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    0,
    0
   ]
  },
  {
   "parameters": {

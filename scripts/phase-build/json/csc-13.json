     "value": "system_config"
    },
    "matchType": "allConditions",
    "filters": {
     "conditions": [
      {
       "keyName": "config_key",
       "condition": "eq",
       "keyValue": "=RAZORPAY_WEBHOOK_SECRET"
      }
     ]
    },
    "returnAll": false,
    "limit": 1
   },
   "name": "Get Webhook Secret",
   "type": "n8n-nodes-base.dataTable",

    0
   ],
   "alwaysOutputData": true
  },
  {
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "\nconst app = $('Get App').first().json;\nconst chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ123456789';\nlet num = '';\nfor (let i = 0; i < 6; i++) num += chars[Math.floor(Math.random() * chars.length)];\nconst prefix = 'CSC-2026-';\nconst existing = app.application_number || '';\nconst final = existing || (prefix + num);\nreturn [{ json: { application_number: final, application_id: app.application_id, status: app.status } }];"
   },

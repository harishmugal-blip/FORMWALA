   ]
  },
  {
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "\nconst u = $('Update Doc Locally').first().json;\nconst m = $('Match Next Doc').first().json;\nconst savedKeys = [];\nreturn [{ json: { reply: '\\u2705 Document mil gaya (' + u.savedCount + '/' + u.total + ').\\n\\nAgla document bhejein. Kaam ho jaye to kuch na type karein - main khud aage badha dunga.', phone: u.phone } }];"
   },
   "name": "Next Doc Ask",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    0,
    0
   ]
  },
  {
   "parameters": {

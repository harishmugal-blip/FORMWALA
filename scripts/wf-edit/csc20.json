   {
    "id": "11b94b3c-2dc4-42ba-ba45-2d03718d2a68",
    "name": "Check WA Creds",
    "type": "n8n-nodes-base.code",
    "typeVersion": 2,
    "position": [
     0,
     0
    ],
    "parameters": {
     "mode": "runOnceForAllItems",
     "jsCode": "\nconst pid = $('Get Phone ID').first().json.config_value || '';\nconst token = $('Get Token').first().json.config_value || '';\nconst ver = $('Get API Ver').first().json.config_value || 'https://graph.facebook.com/v21.0';\nconst t = $('Trigger').first().json;\nconst ready = pid && token && !pid.startsWith('SET_') && !token.startsWith('SET_');\nreturn [{ json: { ready, pid, token, ver, phone: t.phone, message: t.message, template: t.template || 'GENERIC', related_id: t.related_id || t.phone } }];"
    }
   },
   {
    "id": "82058fa2-8aea-4955-b54c-696e20a69140",
    "name": "Creds Ready?",
    "type": "n8n-nodes-base.if",
    "typeVersion": 2.2,
    "position": [
     0,
     0
    ],
    "parameters": {
     "conditions": {
      "options": {
       "caseSensitive": true,
       "leftValue": "",
       "typeValidation": "loose",
       "version": 2
      },
      "conditions": [
       {
        "id": "c0-CredsReady",
        "leftValue": "={{ $json.ready }}",
        "rightValue": "true",
        "operator": {
         "type": "string",
         "operation": "equals"
        }
       }
      ],
      "combinator": "and"
     },
     "options": {}
    }

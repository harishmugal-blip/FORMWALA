  {
   "id": "11b94b3c-2dc4-42ba-ba45-2d03718d2a68",
   "name": "Check WA Creds",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    0,
    0
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "const pid = $('Get Phone ID').first().json.config_value || '';\nconst token = $('Get Token').first().json.config_value || '';\nconst ver = $('Get API Ver').first().json.config_value || 'https://graph.facebook.com/v21.0';\nconst evoUrlRow = $('Get EVO URL').first().json || {};\nconst evoKeyRow = $('Get EVO API Key').first().json || {};\nconst evoInstRow = $('Get EVO Instance').first().json || {};\nconst evoUrl = (evoUrlRow.config_value || '').replace(/\\/+$/, '');\nconst evoKey = evoKeyRow.config_value || '';\nconst evoInst = evoInstRow.config_value || '';\nconst isSet = v => v && !v.startsWith('SET_');\nconst metaReady = isSet(pid) && isSet(token);\nconst evoReady = isSet(evoUrl) && isSet(evoKey) && isSet(evoInst);\nconst mode = evoReady ? 'evo' : (metaReady ? 'meta' : 'mock');\nconst t = $('Trigger').first().json;\nreturn [{ json: { ready: metaReady, evoReady, mode, pid, token, ver, evoUrl, evoKey, evoInst, phone: t.phone, message: t.message, template: t.template || 'GENERIC', related_id: t.related_id || t.phone } }];"
   }
  },
  {
   "id": "f7115967-25e2-4c05-8529-765904b493cc",
   "name": "Send WhatsApp",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "onError": "continueRegularOutput",
   "position": [
    0,
    0
   ],
   "parameters": {
    "method": "POST",
    "url": "={{ $json.ver }}/{{ $json.pid }}/messages",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "Authorization",
       "value": "=Bearer {{ $('Check WA Creds').first().json.token }}"
      },
      {
       "name": "Content-Type",
       "value": "application/json"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $('Check WA Creds').first().json.phone, type: 'text', text: { body: $('Check WA Creds').first().json.message } }) }}",
    "options": {
     "response": {
      "response": {
       "neverError": true
      }
     },
     "timeout": 30000
    }
   }
  },
  {
   "id": "f25ed84b-cf1b-4f0c-9908-ce0f75bdc822",
   "name": "Update Sent Status",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    0,
    0
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "const r = $json;\nconst waMsgId = (r.messages && r.messages[0] && r.messages[0].id) || (r.key && r.key.id) || '';\nconst err = r.error ? String(r.error.message || JSON.stringify(r.error)).slice(0, 500) : '';\nreturn [{ json: { waMsgId, err, phone: $('Check WA Creds').first().json.phone, related_id: $('Check WA Creds').first().json.related_id } }];"
   }
  },
